import crypto from 'node:crypto';

function send(res, status, body) {
  res.status(status);
  res.setHeader('Content-Type', 'application/json; charset=utf-8');
  res.setHeader('Cache-Control', 'no-store');
  res.end(JSON.stringify(body));
}

function getEnvironment() {
  const url = process.env.SUPABASE_URL;
  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
  if (!url || !key) throw new Error('Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY');
  return { url: url.replace(/\/$/, ''), key };
}

function databaseHeaders(key, extra = {}) {
  return {
    apikey: key,
    Authorization: `Bearer ${key}`,
    'Content-Type': 'application/json',
    ...extra
  };
}

function newId() {
  return crypto.randomBytes(9).toString('base64url');
}

function newSecret() {
  return crypto.randomBytes(24).toString('base64url');
}

function hash(value) {
  return crypto.createHash('sha256').update(value).digest('hex');
}

export default async function handler(req, res) {
  if (req.method === 'GET') {
    return send(res, 200, { ok: true, service: 'special-teams-project-storage', method: 'POST', version: '7.1' });
  }
  if (req.method !== 'POST') {
    res.setHeader('Allow', 'GET, POST');
    return send(res, 405, { error: 'Method not allowed' });
  }

  try {
    const { url, key } = getEnvironment();
    const body = typeof req.body === 'string' ? JSON.parse(req.body || '{}') : (req.body || {});
    const action = String(body.action || 'save');

    if (action === 'load') {
      const projectId = String(body.projectId || '').trim();
      if (!projectId) return send(res, 400, { error: 'Missing project ID' });
      const response = await fetch(`${url}/rest/v1/special_teams_projects?id=eq.${encodeURIComponent(projectId)}&select=id,data,updated_at`, {
        headers: databaseHeaders(key)
      });
      const records = await response.json().catch(() => []);
      if (!response.ok) throw new Error(records?.message || 'Database read failed');
      if (!records.length) return send(res, 404, { error: 'Project not found' });
      return send(res, 200, { projectId: records[0].id, data: records[0].data, updatedAt: records[0].updated_at });
    }

    const data = body.data;
    if (!data || typeof data !== 'object') return send(res, 400, { error: 'Missing project data' });
    const serialized = JSON.stringify(data);
    if (serialized.length > 12_000_000) return send(res, 413, { error: 'Project is too large for this build. Reduce the CSV size.' });

    let projectId = String(body.projectId || '').trim();
    let editKey = String(body.editKey || '').trim();

    if (!projectId) {
      projectId = newId();
      editKey = newSecret();
      const response = await fetch(`${url}/rest/v1/special_teams_projects`, {
        method: 'POST',
        headers: databaseHeaders(key, { Prefer: 'return=minimal' }),
        body: JSON.stringify({ id: projectId, edit_key_hash: hash(editKey), data })
      });
      if (!response.ok) throw new Error((await response.text()) || 'Database insert failed');
      return send(res, 200, { projectId, editKey, created: true });
    }

    if (!editKey) return send(res, 403, { error: 'This browser does not have the edit key for this project. Create a new project to make an editable copy.' });

    const lookup = await fetch(`${url}/rest/v1/special_teams_projects?id=eq.${encodeURIComponent(projectId)}&select=edit_key_hash`, {
      headers: databaseHeaders(key)
    });
    const records = await lookup.json().catch(() => []);
    if (!lookup.ok) throw new Error(records?.message || 'Database lookup failed');
    if (!records.length) return send(res, 404, { error: 'Project not found' });
    if (records[0].edit_key_hash !== hash(editKey)) return send(res, 403, { error: 'Invalid edit key' });

    const response = await fetch(`${url}/rest/v1/special_teams_projects?id=eq.${encodeURIComponent(projectId)}`, {
      method: 'PATCH',
      headers: databaseHeaders(key, { Prefer: 'return=minimal' }),
      body: JSON.stringify({ data, updated_at: new Date().toISOString() })
    });
    if (!response.ok) throw new Error((await response.text()) || 'Database update failed');
    return send(res, 200, { projectId, updated: true });
  } catch (error) {
    return send(res, 500, { error: error?.message || 'Server error' });
  }
}
