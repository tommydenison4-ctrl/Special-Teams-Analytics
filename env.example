import crypto from 'node:crypto';

const JSON_HEADERS = {
  'content-type': 'application/json; charset=utf-8',
  'cache-control': 'no-store'
};

function reply(status, body) {
  return new Response(JSON.stringify(body), { status, headers: JSON_HEADERS });
}

function env() {
  const url = process.env.SUPABASE_URL;
  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
  if (!url || !key) throw new Error('Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY');
  return { url: url.replace(/\/$/, ''), key };
}

function dbHeaders(key, extra = {}) {
  return {
    apikey: key,
    Authorization: `Bearer ${key}`,
    'content-type': 'application/json',
    ...extra
  };
}

function newId() {
  return crypto.randomBytes(9).toString('base64url');
}

function newSecret() {
  return crypto.randomBytes(24).toString('base64url');
}

function hash(value) {
  return crypto.createHash('sha256').update(value).digest('hex');
}

async function parseJson(request) {
  try { return await request.json(); } catch { return {}; }
}

export function GET() {
  return reply(200, { ok: true, service: 'special-teams-project-storage', methods: ['GET', 'POST'], version: '7.0' });
}

export async function POST(request) {
  try {
    const { url, key } = env();
    const body = await parseJson(request);
    const action = String(body.action || 'save');

    if (action === 'load') {
      const projectId = String(body.projectId || '').trim();
      if (!projectId) return reply(400, { error: 'Missing project ID' });
      const response = await fetch(`${url}/rest/v1/special_teams_projects?id=eq.${encodeURIComponent(projectId)}&select=id,data,updated_at`, {
        headers: dbHeaders(key)
      });
      const records = await response.json().catch(() => []);
      if (!response.ok) throw new Error(records?.message || 'Database read failed');
      if (!records.length) return reply(404, { error: 'Project not found' });
      return reply(200, { projectId: records[0].id, data: records[0].data, updatedAt: records[0].updated_at });
    }

    const data = body.data;
    if (!data || typeof data !== 'object') return reply(400, { error: 'Missing project data' });
    const serialized = JSON.stringify(data);
    if (serialized.length > 12_000_000) return reply(413, { error: 'Project is too large for this build. Reduce the CSV size.' });

    let projectId = String(body.projectId || '').trim();
    let editKey = String(body.editKey || '').trim();

    if (!projectId) {
      projectId = newId();
      editKey = newSecret();
      const response = await fetch(`${url}/rest/v1/special_teams_projects`, {
        method: 'POST',
        headers: dbHeaders(key, { Prefer: 'return=minimal' }),
        body: JSON.stringify({ id: projectId, edit_key_hash: hash(editKey), data })
      });
      if (!response.ok) throw new Error((await response.text()) || 'Database insert failed');
      return reply(200, { projectId, editKey, created: true });
    }

    if (!editKey) return reply(403, { error: 'This browser does not have the edit key for this project. Create a new project to make an editable copy.' });

    const lookup = await fetch(`${url}/rest/v1/special_teams_projects?id=eq.${encodeURIComponent(projectId)}&select=edit_key_hash`, {
      headers: dbHeaders(key)
    });
    const records = await lookup.json().catch(() => []);
    if (!lookup.ok) throw new Error(records?.message || 'Database lookup failed');
    if (!records.length) return reply(404, { error: 'Project not found' });
    if (records[0].edit_key_hash !== hash(editKey)) return reply(403, { error: 'Invalid edit key' });

    const response = await fetch(`${url}/rest/v1/special_teams_projects?id=eq.${encodeURIComponent(projectId)}`, {
      method: 'PATCH',
      headers: dbHeaders(key, { Prefer: 'return=minimal' }),
      body: JSON.stringify({ data, updated_at: new Date().toISOString() })
    });
    if (!response.ok) throw new Error((await response.text()) || 'Database update failed');
    return reply(200, { projectId, updated: true });
  } catch (error) {
    return reply(500, { error: error?.message || 'Server error' });
  }
}
